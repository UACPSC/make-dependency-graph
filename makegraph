#!/usr/bin/env python3
"""
makegraph - Generate an SVG dependency graph from a Makefile

Usage: makegraph [Makefile] [-o output.svg] [--dot] [--link URL]

The first non-blank comment line in the Makefile is used as the title.
Hovering over a target shows its rule, with the comment and .PHONY line just before it, and
their line numbers. With --link, clicking the title opens URL, such as the Makefile's page on
GitHub, and clicking a target opens URL#Lstart-Lend, which GitHub shows with the rule's lines
highlighted.

Edges point from a target to its prerequisites; dashed edges come from pattern rules (%.o : %.cpp),
which also make the files they build count as generated. Target-specific variables
(prog : CXXFLAGS += -g) are shown in the target's tooltip. Node colors:
  green - phony targets (.PHONY)
  red   - generated files (targets with rules)
  black - source files (prerequisites only)

Requires Graphviz (dot) to render the SVG.
"""

import argparse
import html
import os
import re
import shutil
import subprocess
import sys

VAR_REF = re.compile(r"\$\(([^()]+)\)|\$\{([^{}]+)\}")

# a variable assignment: VAR = val, VAR := val, VAR ?= val, VAR += val
ASSIGNMENT = r"^\s*(?:export\s+|override\s+)?([A-Za-z_][A-Za-z0-9_.]*)\s*([:?+!]?=)\s*(.*)$"


def read_logical_lines(path):
    """Yield (kind, text, line number) for each line of the Makefile, joining backslash continuations.

    kind is "recipe" (a tab-indented recipe line), "comment", "blank", or "line" (anything else,
    with any trailing comment removed).
    """
    with open(path) as f:
        raw = f.read().splitlines()

    buf = ""
    start = 0       # line number of the first line of a continued line
    for number, line in enumerate(raw, 1):
        if not buf and line.startswith("\t"):
            yield "recipe", line[1:], number
            continue
        if not buf:
            start = number
        if line.endswith("\\"):
            buf += line[:-1] + " "
            continue
        buf += line
        if not buf.strip():
            yield "blank", "", start
        elif buf.lstrip().startswith("#"):
            yield "comment", buf.strip(), start
        else:
            yield "line", buf.split("#", 1)[0].rstrip(), start
        buf = ""


def read_title(path):
    """Return the text of the first non-blank comment line, or None."""
    with open(path) as f:
        for line in f:
            # recipe lines start with a tab, so their comments are shell comments
            if line.startswith("\t") or not line.lstrip().startswith("#"):
                continue
            text = line.strip().lstrip("#").strip()
            if text:
                return text
    return None


def expand(text, variables, depth=0):
    """Expand simple $(VAR) and ${VAR} references."""
    if depth > 10:
        return text

    def repl(m):
        name = m.group(1) or m.group(2)
        return expand(variables.get(name, ""), variables, depth + 1)

    return VAR_REF.sub(repl, text)


def pattern_stem(pattern, name):
    """The part of name that % matches in pattern, or None if pattern does not match."""
    prefix, _, suffix = pattern.partition("%")
    if len(name) > len(prefix) + len(suffix) and name.startswith(prefix) and name.endswith(suffix):
        return name[len(prefix):len(name) - len(suffix)]
    return None


def parse_makefile(path):
    """Return (ordered list of targets, dict target -> prerequisites, set of phony targets,
    dict target -> list of (line number, text) for its tooltip, dict target -> (first, last) line
    numbers to link to, set of (target, prerequisite) edges that come from pattern rules)."""
    variables = {}
    deps = {}
    order = []
    phony = set()
    leading = {}    # rule -> comment and .PHONY lines just before it
    rules = {}      # rule -> lines of the rule as written, recipe indented with spaces
    patterns = []   # (key, target pattern, prerequisite patterns) of pattern rules, in order
    extra = {}      # target -> its target-specific variable lines, with the comment before them

    pending = []    # (number, line, phony targets or None for a comment) just before the current line
    current = []    # rules the most recent rule line started, which recipe lines belong to
    for kind, line, number in read_logical_lines(path):
        if kind == "recipe":
            for key in current:
                rules[key].append((number, "    " + line))
            continue
        if kind == "blank":
            pending = []
            continue
        if kind == "comment":
            # skip comment lines with no text, such as "#" or "######"
            if line.lstrip("#").strip():
                pending.append((number, line, None))
            continue

        current = []
        # variable assignments: VAR = val, VAR := val, VAR ?= val, VAR += val
        m = re.match(ASSIGNMENT, line)
        if m:
            name, op, value = m.groups()
            if op == "+=":
                variables[name] = (variables.get(name, "") + " " + value).strip()
            elif op == "?=":
                variables.setdefault(name, value)
            elif op == ":=":
                variables[name] = expand(value, variables)
            else:
                variables[name] = value
            pending = []
            continue

        # rules: targets : prerequisites [; recipe]
        m = re.match(r"^([^:=]+?)\s*::?\s*(.*)$", line)
        if not m:
            pending = []
            continue
        targets = expand(m.group(1), variables).split()
        prereqs_text = m.group(2).split(";", 1)[0]

        # target-specific variables, such as "prog : CXXFLAGS += -g", are not prerequisites, but are
        # shown in the target's tooltip
        if re.match(ASSIGNMENT, prereqs_text):
            for target in targets:
                if "%" not in target and not target.startswith("."):
                    lines = [(n, text) for n, text, names in pending if names is None] + [(number, line.strip())]
                    extra.setdefault(target, []).extend(lines)
            pending = []
            continue

        # static pattern rules: targets : target-pattern : prerequisite-patterns
        static = None
        if ":" in prereqs_text:
            target_pattern, _, prereqs_text = prereqs_text.partition(":")
            static = expand(target_pattern, variables).strip()

        # drop order-only marker but keep the prerequisites
        prereqs = expand(prereqs_text, variables).replace("|", " ").split()

        # a comment and .PHONY line before a rule belong with that rule
        if targets == [".PHONY"]:
            phony.update(prereqs)
            pending.append((number, line.strip(), prereqs))
            continue

        for target in targets:
            # skip other special targets, such as .SUFFIXES
            if target.startswith("."):
                continue

            # a pattern rule, applied below to the files it can build
            if "%" in target and not static:
                key = ("pattern", len(patterns))
                patterns.append((key, target, prereqs))
                leading[key] = [(n, text) for n, text, names in pending if names is None]
                rules[key] = [(number, line.strip())]
                current.append(key)
                continue

            stem = pattern_stem(static, target) if static else None
            target_prereqs = [p.replace("%", stem, 1) for p in prereqs] if stem is not None else prereqs

            if target not in deps:
                deps[target] = []
                order.append(target)
                rules[target] = []
            for p in target_prereqs:
                if p not in deps[target]:
                    deps[target].append(p)
            if target not in leading:
                # a .PHONY line only belongs with a rule for a target it declares
                leading[target] = [(n, text) for n, text, names in pending if names is None or target in names]
            rules[target].append((number, line.strip()))
            current.append(target)
        pending = []

    tooltips = {target: leading[target] + rules[target] for target in order}
    ranges = {target: (tooltips[target][0][0], tooltips[target][-1][0]) for target in order}
    implicit = set()

    # apply pattern rules, like make: to files with no recipe of their own, using the first pattern
    # rule whose prerequisites are known files or exist, or else the first that matches
    directory = os.path.dirname(path)
    has_recipe = {target for target in order if any(text.startswith("    ") for _, text in rules[target])}
    queue = [n for t in order for n in [t] + deps[t]]
    seen = set()
    while queue:
        name = queue.pop(0)
        if name in seen or name in phony or name in has_recipe:
            continue
        seen.add(name)

        chosen = None
        for key, target_pattern, prereq_patterns in patterns:
            stem = pattern_stem(target_pattern, name)
            # a pattern rule with no recipe cancels a built-in rule and builds nothing
            if stem is None or len(rules[key]) == 1:
                continue
            prereqs = [p.replace("%", stem, 1) for p in prereq_patterns]
            if all(p in deps or p in seen or os.path.exists(os.path.join(directory, p)) for p in prereqs):
                chosen = (key, prereqs)
                break
            if chosen is None:
                chosen = (key, prereqs)
        if chosen is None:
            continue

        key, prereqs = chosen
        if name not in deps:
            deps[name] = []
            order.append(name)
            tooltips[name] = []
        # the pattern rule's lines follow any explicit rule for the file, such as one listing headers
        pattern_lines = leading[key] + rules[key]
        if not tooltips[name]:
            ranges[name] = (pattern_lines[0][0], pattern_lines[-1][0])
        tooltips[name] = tooltips[name] + pattern_lines
        for p in prereqs:
            if p not in deps[name]:
                deps[name].append(p)
                implicit.add((name, p))
            queue.append(p)

    # add target-specific variable lines, keeping the tooltip in file order
    for target in order:
        if target in extra:
            tooltips[target] = sorted(set(tooltips[target] + extra[target]))

    return order, deps, phony, tooltips, ranges, implicit


def quote(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'


def tooltip_text(lines):
    """The tooltip lines, each after its right-aligned line number."""
    width = max(len(str(n)) for n, _ in lines)
    return "\n".join(f"{n:>{width}}  {text}" for n, text in lines)


def to_dot(order, deps, phony, tooltips, ranges, implicit, title=None, link=None):
    out = ["digraph G {"]
    if title and link:
        # an HTML-like label, so only the title is a link and not the whole background
        cell = f'<td href="{html.escape(link)}" tooltip="View this version of the Makefile">{html.escape(title)}</td>'
        out.append(f'    label=<<table border="0" cellborder="0"><tr>{cell}</tr></table>>; labelloc=t; fontsize=20;')
    elif title:
        out.append(f"    label={quote(title)}; labelloc=t; fontsize=20;")
    out.append("    node [shape=ellipse];")

    out.append("    key [shape=plaintext, label=<")
    out.append("        <table border=\"0\" cellborder=\"0\" cellspacing=\"0\">")
    out.append("        <tr><td align=\"left\"><font color=\"green\">&#9679; Phony Targets</font></td></tr>")
    out.append("        <tr><td align=\"left\"><font color=\"red\">&#9679; Generated Files</font></td></tr>")
    out.append("        <tr><td align=\"left\">&#9679; Source Files</td></tr>")
    if implicit:
        out.append("        <tr><td align=\"left\">&#8674; From Pattern Rules</td></tr>")
    out.append("        </table>>];")

    # every node in first-seen order: targets, then prerequisites
    nodes = []
    for t in order:
        for n in [t] + deps[t]:
            if n not in nodes:
                nodes.append(n)

    for n in nodes:
        if n in phony:
            color = "green"
        elif n in deps:
            color = "red"
        else:
            color = "black"
        attrs = f"fontcolor={color}"
        if n in tooltips:
            attrs += f", tooltip={quote(tooltip_text(tooltips[n]))}"
            if link:
                # open the rule's lines, as GitHub highlights them
                attrs += f", URL={quote(f'{link}#L{ranges[n][0]}-L{ranges[n][1]}')}"
        out.append(f"    {quote(n)} [{attrs}];")

    for t in order:
        for p in deps[t]:
            style = " [style=dashed]" if (t, p) in implicit else ""
            out.append(f"    {quote(t)} -> {quote(p)}{style};")

    out.append("}")
    return "\n".join(out) + "\n"


def remove_titles(svg):
    """Remove the <title> Graphviz gives the graph, every node, and every edge.

    Browsers show these as tooltips (the graph name, node names, "a->b"), which would compete with
    the target tooltips.
    """
    return re.sub(r"<title>[^<]*</title>\n?", "", svg)


def main():
    parser = argparse.ArgumentParser(prog="makegraph", description="Generate an SVG dependency graph from a Makefile")
    parser.add_argument("makefile", nargs="?", default="Makefile", help="Makefile to read (default: Makefile)")
    parser.add_argument("-o", "--output", default="makegraph.svg", help="output SVG file (default: makegraph.svg)")
    parser.add_argument("--dot", action="store_true", help="print the Graphviz DOT source instead of rendering")
    parser.add_argument("--link", metavar="URL",
                        help="make the title a link to URL, and each target a link to URL#Lstart-Lend, the lines of its rule")
    args = parser.parse_args()

    try:
        dot_source = to_dot(*parse_makefile(args.makefile), title=read_title(args.makefile), link=args.link)
    except OSError as e:
        sys.exit(f"makegraph: {e}")

    if args.dot:
        sys.stdout.write(dot_source)
        return

    if not shutil.which("dot"):
        sys.exit("makegraph: Graphviz 'dot' not found; install Graphviz or use --dot")

    result = subprocess.run(["dot", "-Tsvg"], input=dot_source, capture_output=True, text=True)
    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        sys.exit(result.returncode)
    with open(args.output, "w") as f:
        f.write(remove_titles(result.stdout))


if __name__ == "__main__":
    main()
